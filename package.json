{
  "name": "@anthonyshort/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agent skills for Codex, Pi and Claude Code",
  "scripts": {
    "build": "node --import tsx scripts/build/workflow.ts",
    "build:check": "node --import tsx scripts/build/workflow.ts --check",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "test:workflow": "node --import tsx --test tests/review-workflow.test.ts tests/review-stages.test.ts tests/review-publication.test.ts",
    "test:unit": "node --import tsx --test tests/review-bundle.test.ts",
    "test": "npm run typecheck && npm run build:check && npm run test:workflow && npm run test:unit && python3 -m unittest discover -s skills/review/scripts -p test_*.py && python3 -m unittest discover -s skills/review-workflow/scripts -p test_*.py"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "subagents": {
      "workflows": [
        "./workflows"
      ]
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@tintinweb/pi-subagents": "0.22.0",
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "type": "module"
}
