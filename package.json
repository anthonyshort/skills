{
  "name": "@anthonyshort/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agent skills for Codex, Pi and Claude Code",
  "scripts": {
    "build": "node --import tsx scripts/build/workflow.ts",
    "build:check": "node --import tsx scripts/build/workflow.ts --check",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test:unit": "node --import tsx --import ./scripts/test/markdown.ts --test src/review/*.test.ts src/workflow/*.test.ts",
    "test": "npm run typecheck && npm run format:check && npm run build:check && npm run test:unit",
    "format": "oxfmt --write \"src/**/*.ts\" \"scripts/**/*.ts\""
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "subagents": {
      "workflows": [
        "./workflows"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "typescript": "7.0.2",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "type": "module"
}
