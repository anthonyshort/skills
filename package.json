{
  "name": "@anthonyshort/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agent skills for Codex, Pi and Claude Code",
  "scripts": {
    "review": "node scripts/run-review.mjs",
    "test:workflow": "node tests/review-workflow.test.mjs",
    "test:unit": "node --test tests/review-bundle.test.mjs tests/review-launcher.test.mjs",
    "test:pi": "node scripts/test-review-pi.mjs",
    "test": "npm run test:workflow && npm run test:unit && python3 -m unittest discover -s scripts/review -p test_*.py && python3 -m unittest discover -s skills/review/scripts -p test_*.py"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "subagents": {
      "workflows": [
        "./workflows"
      ]
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@tintinweb/pi-subagents": "0.22.0"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
